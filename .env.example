# =============================================================================
# KMSIT COMPUTER — .env.example
# Salin menjadi .env (installer menulis file ini otomatis saat instalasi).
# JANGAN commit .env ke version control. JANGAN hardcode secret di kode.
# =============================================================================

APP_NAME="KMSIT Computer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_MAINTENANCE=false

# --- MySQL (satu-satunya database utama) ------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kmsit_computer
DB_USERNAME=kmsit
DB_PASSWORD=

# --- Session & cache ---------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Payment Gateway: Tripay -------------------------------------------------
# Mode: sandbox | live  (sandbox memakai credential TRI prefixed bila tersedia)
PAYMENT_GATEWAY=tripay
PAYMENT_MODE=sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_CALLBACK_URL="${APP_URL}/api/v1/payments/callback"

# --- Payment Gateway: Xendit -------------------------------------------------
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_CALLBACK_URL="${APP_URL}/api/v1/payments/callback"

# --- Payment Gateway: Stripe -------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=idr

# --- Ekonomi platform ---------------------------------------------------------
# Persentase service fee platform dari setiap penjualan kelas berbayar
PLATFORM_FEE_PERCENT=15

# --- Google Maps --------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- File storage --------------------------------------------------------------
FILESYSTEM_DISK=public
MEDIA_MAX_KB=1800

# --- Rate limiting API ---------------------------------------------------------
API_THROTTLE_PER_MINUTE=60
