APP_NAME="KMSIT Computer"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kmsitcomputer.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kmsit_computer
DB_USERNAME=kmsit
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Production target (IMP-001): Redis for cache + queue, drained by a Supervisor/systemd
# worker. Sessions stay out of Redis (SESSION_DRIVER=file here; database also supported).
# The single cron entry "* * * * * php artisan schedule:run" is still required
# (voucher reclaim, heartbeat, failed-job pruning).
# See docs/operations-queue-scheduler.md. Verify with "php artisan production:check".
CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_SCHEDULER_WORKER=false
FILESYSTEM_DISK=public

# Fallback profile on shared hosting without Redis/Supervisor (opt-in only):
# CACHE_STORE=file
# QUEUE_CONNECTION=database
# QUEUE_SCHEDULER_WORKER=true
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=kmsit-

# smtp uses STARTTLS on 587; set MAIL_SCHEME=smtps for implicit TLS on port 465.
# "log" writes reset links to the log file and is flagged by production:check.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@kmsitcomputer.com
MAIL_FROM_NAME="${APP_NAME}"

# Payment gateways. Provider HTTP calls only run when PAYMENT_MODE=live;
# sandbox mode uses the internal simulation flow and never contacts a provider.
PAYMENT_MODE=sandbox
PAYMENT_GATEWAY=tripay
PAYMENT_HTTP_TIMEOUT=15
PAYMENT_HTTP_CONNECT_TIMEOUT=5
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_WEBHOOK_SECRET=
TRIPAY_BASE_URL=https://tripay.co.id/api
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com

# RajaOngkir Shipping Cost V2 (backend only — never expose the key to the browser).
# Origin is the store's sub-district ID from the region API (server-controlled).
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
SHIPPING_ORIGIN_SUBDISTRICT_ID=
SHIPPING_COURIERS=jne:jnt:sicepat

# OpenRouteService routing for Local Delivery (backend only — never expose the key).
# Tariffs/eligibility are Dashboard runtime settings, not env.
OPENROUTE_API_KEY=
OPENROUTE_BASE_URL=https://api.openrouteservice.org
OPENROUTE_PROFILE=driving-car

# Configuration only — no runtime Zoom/Google Meet integration yet; see docs/integrations-status.md.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
