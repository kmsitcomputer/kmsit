APP_NAME="KMSIT Computer"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kmsitcomputer.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kmsit_computer
DB_USERNAME=kmsit
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Default profile works without Redis (installer / shared hosting): file cache + database
# queue drained by the single cron entry "* * * * * php artisan schedule:run".
# See docs/operations-queue-scheduler.md. Verify with "php artisan production:check".
CACHE_STORE=file
QUEUE_CONNECTION=database
QUEUE_SCHEDULER_WORKER=true
FILESYSTEM_DISK=public

# Recommended profile on a VPS with Redis + Supervisor/systemd worker:
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# QUEUE_SCHEDULER_WORKER=false
# SESSION_DRIVER=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_PREFIX=kmsit-

# smtp uses STARTTLS on 587; set MAIL_SCHEME=smtps for implicit TLS on port 465.
# "log" writes reset links to the log file and is flagged by production:check.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@kmsitcomputer.com
MAIL_FROM_NAME="${APP_NAME}"

# Payment gateways. Provider HTTP calls only run when PAYMENT_MODE=live;
# sandbox mode uses the internal simulation flow and never contacts a provider.
PAYMENT_MODE=sandbox
PAYMENT_GATEWAY=tripay
PAYMENT_HTTP_TIMEOUT=15
PAYMENT_HTTP_CONNECT_TIMEOUT=5
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_WEBHOOK_SECRET=
TRIPAY_BASE_URL=https://tripay.co.id/api
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com

# Configuration only — no runtime Zoom/Google Meet integration yet; see docs/integrations-status.md.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
